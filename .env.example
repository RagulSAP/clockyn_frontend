# Clockyn environment — copy to `.env` (never commit real values).
# All EXPO_PUBLIC_* variables are bundled into the client; do not put secrets there.

# Backend
EXPO_PUBLIC_API_BASE_URL=

# Support / legal links shown in-app (provide your own values)
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SALES_EMAIL=
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_WEB_PORTAL_URL=
EXPO_PUBLIC_ANDROID_STORE_URL=
EXPO_PUBLIC_IOS_STORE_URL=

# Usage analytics (screen views and button taps; no typed text) shown on the Clickstream page of the admin web app.
# Leave empty (on). `off` switches it off for this build.
EXPO_PUBLIC_ANALYTICS=

# Employee Access (staff / manager sign-in) works only in the Android / iOS app. In a browser the app explains this in a dialog.
# Leave empty. `true` lifts the browser block and is used only by the automated browser tests (npm run e2e:build sets it).
EXPO_PUBLIC_ALLOW_WEB_EMPLOYEE=

# Native build identity (app.config.ts)
APP_ID=com.clockyn.app
EAS_PROJECT_ID=
GOOGLE_MAPS_API_KEY=
# Optional Firebase push files (FCM). When absent, push is disabled gracefully.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist
